# ============================================================
# auto-evaluation 凭证配置模板
# ============================================================
# 使用方法：
#   1) 复制本文件为 .env（放在与本文件相同的包根目录）：
#        cp .env.example .env
#   2) 按下面说明填入你自己的 Token / Key（等号后直接写值，无需引号）
#   3) 正常运行 run_pipeline.py / evaluate_existing_results.py 即可
#
# 说明：
#   - .env 只需填一次，全流程所有 stage 共享读取。
#   - 系统真实环境变量（export）优先级高于 .env，不会被覆盖。
#   - API 地址等非敏感项已在代码内置默认值，通常无需填写；如需切换见文件末尾。
#   - .env 已被 .gitignore 忽略，请勿提交或外传你的真实密钥。
# ============================================================

# —— 百度 OCR 切题（Stage 1）——
# 百度智能云 OCR 应用的 API Key / Secret Key
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# —— 千帆大模型（Stage 2 有效性分类 / Stage 3 五模型解题）——
# 千帆 Bearer Token，只填 token 本身，不要带 "Bearer " 前缀
# 形如：bce-v3/ALTAK-xxxx/xxxx
QIANFAN_API_TOKEN=

# —— 华研 API（Stage 4 共识裁判必填；Stage 7 选用 huayan 裁判时需要）——
# 形如：sk-xxxx
HUAYAN_API_KEY=

# —— 百度 BOS 对象存储（Stage 5 上传题图取 URL）——
BOS_ACCESS_KEY=
BOS_SECRET_KEY=

# —— 小度待测模型（Stage 6 解题）——
XIAODU_APP_KEY=
XIAODU_APP_SECRET=

# —— 内部 One API 网关（Stage 7 默认裁判 oneapi-opus-5）——
ONE_API_TOKEN=

# ============================================================
# 可选：非敏感配置覆盖（一般保持默认即可，无需填写）
# ============================================================
# BAIDU_OCR_CREATE_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/paper_cut_edu_vlm/create_task
# BAIDU_OCR_RESULT_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/paper_cut_edu_vlm/get_result
# QIANFAN_API_URL=https://qianfan.baidubce.com/v2/chat/completions
# HUAYAN_API_URL=https://www.huayanapi.com/v1/chat/completions
# ONEAPI_API_URL=https://oneapi-comate.baidu-int.com/v1/chat/completions
# BOS_ENDPOINT=bj.bcebos.com
# BOS_BUCKET=machao
# XIAODU_HOST=xiaodu.baidu.com
# XIAODU_URI=/edu-gateway/gateway/openapi/homework-tob/solve
