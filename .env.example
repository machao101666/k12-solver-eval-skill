# ============================================================
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。
# 也可以不用 .env，直接 export 这些环境变量。
# 填完后执行 python3 config.py 自检。
# ============================================================

# ---- Stage 1：OCR 智能切题 ----------------------------------
# 百度智能云 OCR 应用的 API Key / Secret Key
# https://console.bce.baidu.com/ai/#/ai/ocr/app/list
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ---- Stage 2 / Stage 3：千帆（OpenAI 兼容） -------------------
# 值形如 bce-v3/ALTAK-xxxxx/yyyyy，不要带 "Bearer " 前缀
# https://console.bce.baidu.com/qianfan/
QIANFAN_API_KEY=

# ---- Stage 3 / 4 / 7：OpenAI 兼容聚合网关 --------------------
# 用于 doubao / claude / gemini 等参考模型，以及共识裁判和评分裁判。
# 填任一 OpenAI 兼容端点即可，例如：
#   OpenRouter：https://openrouter.ai/api/v1/chat/completions
#   自建 one-api / vLLM：https://your-gateway/v1/chat/completions
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ---- Stage 5：对象存储（把本地题图转成公网 URL） --------------
# 仅当待测模型只接受图片 URL 时需要（Bucket 需开公开读）。
# 若把 config.yaml 的 providers.target_model.input_mode 改成 image，可跳过 Stage 5，不用填。
BOS_ENDPOINT=bj.bcebos.com
BOS_BUCKET=your-bucket-name
BOS_ACCESS_KEY_ID=
BOS_SECRET_ACCESS_KEY=

# ---- Stage 6：待测模型 --------------------------------------
# 默认 api_style = baidu_solve，即百度智能云 OCR「拍照解题」（推荐）
#   产品页：https://ai.baidu.com/tech/ocr/solve
#   在同一个 OCR 应用里开通「拍照解题」即可，Key 与 Stage 1 可以相同也可以分开
TARGET_SOLVE_API_KEY=
TARGET_SOLVE_SECRET_KEY=

# 若把 config.yaml 的 providers.target_model.api_style 改成 openai_compat，
# 则改填下面三个，用来评测任意 OpenAI 兼容多模态模型：
# TARGET_MODEL_BASE_URL=https://your-gateway/v1/chat/completions
# TARGET_MODEL_API_KEY=
# TARGET_MODEL_NAME=your-vision-model

# ---- 可选：覆盖默认路径 -------------------------------------
# AUTO_EVAL_CONFIG=/path/to/my-config.yaml
# AUTO_EVAL_ENV_FILE=/path/to/other.env
